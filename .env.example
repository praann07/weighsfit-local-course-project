DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=fitstack
SESSION_SECRET=any-long-random-text

# Small admin app (public/ + server.js)
PORT=3000

# Full FitStack app API (api/server.js)
API_PORT=4000
# The login code every user types on the "Check your email" screen (no real email is sent locally)
OTP_CODE=123456
# true = new signups are approved automatically; false = an admin must approve them
AUTO_APPROVE=true
